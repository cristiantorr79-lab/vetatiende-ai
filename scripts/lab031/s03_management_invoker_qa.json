        "jsCode": "const x=$json;\nconst expected={run_id:'PRECHECK_20261104A',clinic_id:'clinica_piloto_001',document_id:'LAB031_S03_PRECHECK_20261104A_DOC_INTERNAL',content:'El código de inventario del material de demostración es QA-S03-742.',hash:'7b093f0c46f7ce64dc7e37dcde7071dfae7506461f4eb54d0c6d2335aeebf2da'};\nconst checks={contract:x.run_id===expected.run_id&&x.clinic_id===expected.clinic_id&&x.document_id===expected.document_id&&x.document_content===expected.content&&x.content_hash===expected.hash,external_bundle:x.external_gate_bundle_status==='VERIFIED'&&/^[a-f0-9]{64}$/.test(String(x.external_gate_bundle_digest||'')),runtime_verifier:x.external_gate_runtime_verified===true,workflow_id:/^[A-Za-z0-9_-]{8,80}$/.test(String(x.management_workflow_id||''))};\nconst missing=Object.entries(checks).filter(([,ok])=>!ok).map(([name])=>name);\nreturn {json:{...x,action:'ingest',document_type:'administrative_demo',visibility:'internal',access_level:'veterinario',source_file:'LAB031_S03_PRECHECK_20261104A_internal.txt',target_version_id:'',gates:checks,missing_gates:missing,authorized:false,block_reason:'EXTERNAL_EVIDENCE_CANNOT_BE_VERIFIED_INSIDE_EDITABLE_WORKFLOW'}};"
      }
