{
  "name": "LAB-030 TEMP post-check documento RAG E2",
  "active": false,
  "versionId": "lab030-temp-postcheck-documento-e2-v3",
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "id": "dyn-post-hook",
      "name": "Entrada protegida post-check LAB-030",
